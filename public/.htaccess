# ===============================================================
#  cPanel / Apache ayarlari
#  Bu dosya, sitenin tum sayfa adreslerinin ( /urunler, /sepet,
#  /admin ... ) dogru acilmasi icin gereklidir.
#  Dosya adi ".htaccess" olarak kalmali, adini degistirmeyin.
# ===============================================================

# Ayni isimde dosya ve klasor varsa Apache karismasin
Options -MultiViews

# Kok adrese girildiginde ana sayfa acilsin
DirectoryIndex index.html

# Turkce karakterlerin bozulmamasini saglar
AddDefaultCharset UTF-8

# ---------------------------------------------------------------
# 1) SAYFA ADRESLERI (404 hatasini onleyen kisim)
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Siteyi public_html ICINE (koke) yukluyorsaniz bu satir kapali kalsin.
  # public_html/bir-klasor ICINE yukluyorsaniz asagidaki satiri acin
  # ve klasor adini yazin (ornek: RewriteBase /magaza/):
  # RewriteBase /magaza/

  # Var olan gercek dosya veya klasor ise dokunma (resim, css, js ...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Geri kalan her adresi tek sayfa uygulamasina devret
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------
# 2) DOGRU DOSYA TIPLERI
# ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# ---------------------------------------------------------------
# 3) SIKISTIRMA (sayfalar daha hizli acilir)
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------
# 4) ONBELLEK (tarayiciyi dogru yonlendirir)
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Codedosyalari isimlerinde surum tasidigi icin uzun sure saklanabilir
  <FilesMatch "\.(js|mjs|css|woff2|png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Ana sayfa her zaman taze kontrol edilsin (guncellemeler hemen gorunsun)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Bazi tarayicilarin dosya tipini tahmin etmesini engeller
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------
# 5) HTTPS YONLENDIRMESI (istege bagli)
#    Sitede SSL sertifikasi (AutoSSL) kurulduktan SONRA
#    asagidaki iki satirin basindaki # isaretlerini kaldirin.
# ---------------------------------------------------------------
